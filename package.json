{
  "name": "ai-agents-tower",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test tests/domain.test.ts",
    "test:ui": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run test:ui",
    "spike:m2": "node spikes/m2/verify-vendor.mjs && node --experimental-strip-types spikes/m2/server.mjs",
    "test:m2": "node spikes/m2/verify-vendor.mjs && playwright test --config spikes/m2/playwright.config.ts"
  },
  "dependencies": { "ajv": "8.20.0" },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "^24.0.0",
    "eslint": "10.15.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8"
  }
}
