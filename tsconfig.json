{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "strict": true,
    "noEmit": true, "allowImportingTsExtensions": true, "resolveJsonModule": true,
    "verbatimModuleSyntax": true, "skipLibCheck": true, "types": ["node"]
  },
  "include": ["src", "tests", "playwright.config.ts", "spikes/m2/**/*.ts"]
}
